--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -183,4 +183,19 @@
 OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 
+extern "C" IOService *
+sweet_display_create(IOService *provider)
+{
+	AppleCLCD *fb = new AppleCLCD;
+
+	if (fb == NULL) {
+		return NULL;
+	}
+	if (!fb->init() || !fb->attach(provider) || !fb->start(provider)) {
+		fb->release();
+		return NULL;
+	}
+	return fb;
+}
+
