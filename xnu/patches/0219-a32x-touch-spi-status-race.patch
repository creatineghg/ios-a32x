+/*
+ * STATUS0 is read-to-clear. ios28-31: polling it in a tight loop lost the flag
+ * when a read raced the hardware setting it (~1 packet in 12: engine done,
+ * flag gone, 20 ms timeout). Linux reads it only once, from the IRQ. So: wait
+ * out the packet first (worst case source clock 26 MHz), then read STATUS0
+ * sparsely. n = bytes in this packet.
+ */
 static bool
-a32x_spi_wait(void)
+a32x_spi_wait(uint32_t n)
 {
 	uint64_t deadline;
+	uint32_t s0;
+	a32x_spin_us((((n + 1) * 8 * 2 * a32x_spi_sck) + 64) / 26 + 2);
 	nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &deadline);
 	deadline += mach_absolute_time();
-	while (SPIR(0x1c) == 0) {               /* STATUS0: finish/pause, read-clear */
+	for (;;) {
+		s0 = SPIR(0x1c);
+		if (a32x_spi_logged < 6) {
+			a32x_spi_logged++;
+			printf("A32X TOUCH: packet of %u: status0 %08x status1 %08x\n", n, s0, SPIR(0x20));
+		}
+		if (s0 != 0) {
+			return true;
+		}
+		a32x_spi_lost++;                /* counts extra polls: 0 = clock estimate holds */
 		if (mach_absolute_time() > deadline) {
-			/* ios28: ~1 packet in 100 never raised STATUS0. If the engine is no
-			 * longer busy (STATUS1 bit 0) the packet went out: take it. */
-			if ((SPIR(0x20) & 1u) == 0) {
-				a32x_spi_lost++;
-				return true;
-			}
 			return false;
 		}
+		a32x_spin_us(25);
 	}
-	return true;
 }
 
