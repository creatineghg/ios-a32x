diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 0ed80b6..89cd82b 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1162,6 +1162,8 @@ a32x_wdt_arm(bool kick)
 	}
 }
 
+extern int sync_internal(void);         /* bsd/vfs/vfs_syscalls.c */
+
 static void
 a32x_wdt_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1181,6 +1183,24 @@ a32x_wdt_thread(__unused void *arg, __unused wait_result_t wr)
 		 * with a TOPRGU software reset, a warm reset like a WDT bite, so the shim
 		 * dumps RAM to bota and boots Android (a32x_autoreset=0 to disable).
 		 */
+		/*
+		 * The iOS root is non-journaled HFS+: a reset with dirty metadata
+		 * leaves blocks used but marked free, and the next boot hands them
+		 * to other files (fsck: "Overlapped extent allocation"; it broke
+		 * accountsd's Accounts3.sqlite). Flush every mount first, twice,
+		 * kicking the watchdog, then give the UFS log thread (SYNCHRONIZE
+		 * CACHE every ~10 s) time to run before the reset.
+		 */
+		for (int pass = 0; pass < 2; pass++) {
+			a32x_wdt_arm(true);
+			printf("A32X WDT: sync pass %d\n", pass + 1);
+			sync_internal();
+		}
+		for (int i = 0; i < 3; i++) {
+			a32x_wdt_arm(true);
+			a32x_wdt_sleep(&a32x_toprgu, 5);
+		}
+		printf("A32X WDT: sync done\n");
 		printf("A32X WDT: kick window over, autoreset (TOPRGU SWRST)\n");
 		uint64_t deadline;
 		nanoseconds_to_absolutetime(NSEC_PER_SEC / 2, &deadline);
