diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index b8e8676..026cf42 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1357,6 +1357,7 @@ a32x_keys_start(void)
 #define A32X_SPI1_PA        0x11010000u
 #define A32X_INFRA_AO_PA    0x10001000u
 #define A32X_NVT_EVENT_BUF  0x11A00u
+#define A32X_GPIO_PA        0x10005000u
 
 extern void sweet_hid_touch(int finger, int down, int x, int y);
 
@@ -1383,8 +1384,9 @@ a32x_spi_wait(void)
 static void
 a32x_spi_init(uint32_t sck)
 {
-	/* CMD: mode 0, MSB first, little endian FIFO words, no DMA, no deassert */
-	a32x_spi_base_cmd = (1u << 12) | (1u << 13);
+	/* CMD: mode 0, MSB first, little endian FIFO words, no DMA, no deassert,
+	 * finish + pause status enabled (the GIC line stays off: we poll STATUS0) */
+	a32x_spi_base_cmd = (1u << 12) | (1u << 13) | (1u << 16) | (1u << 17);
 	SPIR(0x18) = a32x_spi_base_cmd | (1u << 2);     /* reset */
 	SPIR(0x18) = a32x_spi_base_cmd;
 	SPIR(0x24) = 0;                                 /* PAD_SEL */
@@ -1486,6 +1488,40 @@ a32x_touch_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 
 	a32x_wdt_sleep((event_t)&a32x_spi, 5);
+	/*
+	 * Pins (Samsung DT "tsp-on-*" / "reset-on"): SPI1 CLK/CS/MOSI/MISO =
+	 * GPIO 20/21/22/23 mode 1; touch reset = GPIO 7 output high. Android's
+	 * driver sets them; after LK they are plain GPIO inputs. MT6853 GPIO
+	 * @0x10005000: DIR 0x000, DOUT 0x100, MODE 0x300 (+0x10 per 8 pins, 4 bit
+	 * fields), each with SET +4 / CLR +8.
+	 */
+	vm_offset_t gpio = ml_io_map(A32X_GPIO_PA, PAGE_SIZE);
+#define GPIOR(o) (*(volatile uint32_t *)(gpio + (o)))
+	uint32_t m0 = GPIOR(0x300), m2 = GPIOR(0x320), dir = GPIOR(0x000), dout = GPIOR(0x100), din = GPIOR(0x200);
+	GPIOR(0x328) = 0xFFFF0000u;             /* GPIO 20-23 mode -> 0 */
+	GPIOR(0x324) = 0x11110000u;             /* -> mode 1 (SPI1) */
+	GPIOR(0x308) = 0xF0000000u;             /* GPIO 7 mode 0 (GPIO) */
+	GPIOR(0x004) = 1u << 7;                 /* GPIO 7 output */
+	GPIOR(0x108) = 1u << 7;                 /* reset low */
+	a32x_spi_errors = 0;
+	{
+		uint64_t dl;
+		nanoseconds_to_absolutetime(10 * NSEC_PER_MSEC, &dl);
+		dl += mach_absolute_time();
+		while (mach_absolute_time() < dl) {
+		}
+	}
+	GPIOR(0x104) = 1u << 7;                 /* reset high: chip boots from its flash */
+	printf("A32X TOUCH: gpio before mode0 %08x mode2 %08x dir %08x dout %08x din %08x; after mode2 %08x dir %08x dout %08x\n",
+	    m0, m2, dir, dout, din, GPIOR(0x320), GPIOR(0x000), GPIOR(0x100));
+#undef GPIOR
+	{
+		uint64_t dl;
+		nanoseconds_to_absolutetime(300 * NSEC_PER_MSEC, &dl);
+		dl += mach_absolute_time();
+		assert_wait_deadline((event_t)&a32x_spi, THREAD_UNINT, dl);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
 	vm_offset_t infra = ml_io_map(A32X_INFRA_AO_PA, PAGE_SIZE);
 	uint32_t cg_before = *(volatile uint32_t *)(infra + 0xAC);
 	*(volatile uint32_t *)(infra + 0xA8) = 1u << 6;         /* ungate ifrao_spi1 */
