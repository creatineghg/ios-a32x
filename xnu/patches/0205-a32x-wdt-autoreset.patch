diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 0b6a44b..2664cb4 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1102,30 +1102,58 @@ a32x_wdt_sleep(event_t ev, uint64_t secs)
 }
 
 static void
-a32x_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+a32x_wdt_arm(bool kick)
 {
-	while (a32x_wdtkick_left > 0) {
+	/*
+	 * 0184 (sweet_force_hid) switches TOPRGU off once HID starts, and later
+	 * IOKit/userland may do the same: keep it enabled with the shim's mode so
+	 * a dead kernel (no more kicks) still resets into the memdump cycle.
+	 */
+	uint32_t mode = *(volatile uint32_t *)(a32x_toprgu + 0x00);
+	if (!(mode & 1u)) {
+		*(volatile uint32_t *)(a32x_toprgu + 0x00) = 0x22000000u | (a32x_wdt_mode0 & 0x00ffffffu) | 1u;
+		__builtin_arm_dsb(0xf);
+		printf("A32X WDT: TOPRGU was off (mode 0x%x), re-armed 0x%x\n",
+		    mode, *(volatile uint32_t *)(a32x_toprgu + 0x00));
+	}
+	if (kick) {
 		*(volatile uint32_t *)(a32x_toprgu + A32X_WDT_RESTART) = A32X_WDT_RESTART_KEY;
 		__builtin_arm_dsb(0xf);
+	}
+}
+
+static void
+a32x_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t autoreset = 1;
+
+	PE_parse_boot_argn("a32x_autoreset", &autoreset, sizeof(autoreset));
+	while (a32x_wdtkick_left > 0) {
+		a32x_wdt_arm(true);
 		uint32_t step = MIN(a32x_wdtkick_left, 5u);
 		a32x_wdtkick_left -= step;
 		a32x_wdt_sleep((event_t)&a32x_wdtkick_left, step);
 	}
-	/*
-	 * 0184 (sweet_force_hid) switches TOPRGU off once HID starts, which would
-	 * leave a hung boot waiting for the user's keys. Re-arm it with the mode
-	 * the shim left, so every hang/panic still ends in the memdump cycle.
-	 */
-	uint32_t mode = *(volatile uint32_t *)(a32x_toprgu + 0x00);
-	if (!(mode & 1u)) {
-		*(volatile uint32_t *)(a32x_toprgu + 0x00) = 0x22000000u | (a32x_wdt_mode0 & 0x00ffffffu) | 1u;
+	a32x_wdt_arm(true);
+	if (autoreset) {
+		/*
+		 * A live system (launchd running) never trips the watchdog: end the run
+		 * with a TOPRGU software reset, a warm reset like a WDT bite, so the shim
+		 * dumps RAM to bota and boots Android (a32x_autoreset=0 to disable).
+		 */
+		printf("A32X WDT: kick window over, autoreset (TOPRGU SWRST)\n");
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(NSEC_PER_SEC / 2, &deadline);
+		deadline += mach_absolute_time();
+		while (mach_absolute_time() < deadline) {
+		}
+		*(volatile uint32_t *)(a32x_toprgu + 0x14) = 0x1209u;
+		__builtin_arm_dsb(0xf);
 	}
-	*(volatile uint32_t *)(a32x_toprgu + A32X_WDT_RESTART) = A32X_WDT_RESTART_KEY;
-	__builtin_arm_dsb(0xf);
-	printf("A32X WDT: kick window over (mode 0x%x -> 0x%x), reset in <= 31 s if still running\n",
-	    mode, *(volatile uint32_t *)(a32x_toprgu + 0x00));
+	printf("A32X WDT: kick window over, reset in <= 31 s if still running\n");
 	for (;;) {
-		a32x_wdt_sleep((event_t)&a32x_toprgu, 3600);
+		a32x_wdt_arm(false);	/* enable only, no kick: still resets <= 31 s */
+		a32x_wdt_sleep((event_t)&a32x_toprgu, 25);
 	}
 }
 
