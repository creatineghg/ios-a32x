+/*
+ * a32x (0220): the panel copy was one thread, a 64-bit multiply per pixel and
+ * nearest neighbour, and ran on the vsync work loop, so a slow copy also
+ * slowed the vsync iOS paces itself against. Now: own work loop, per-column
+ * table, bands on helper threads, 2x2 average (the frame is scaled x0.64,
+ * nearest neighbour makes text ragged). sweetfb_filter=0, sweetfb_threads=N.
+ */
+#define SWEET_AVG(a, b) (((a) & (b)) + ((((a) ^ (b)) & 0xfefefefeu) >> 1))
+
+struct SweetScale {
+	AppleCLCD     *fb;
+	const uint8_t *base;
+	uint32_t       bpr;
+	int32_t        sx, sy, dx, dy, w, h, pxFrom, pxTo;
+};
+
+static void
+sweet_scale_band(const SweetScale *j, int32_t py0, int32_t py1)
+{
+	AppleCLCD *fb = j->fb;
+	const int32_t *xt = fb->fXTab;
+	const bool filter = fb->fFilter != 0;
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)(((uint64_t)py * fb->fInvY) >> 16);
+		if (ly < j->dy || ly >= j->dy + j->h) {
+			continue;
+		}
+		const uint32_t *r0 = (const uint32_t *)(j->base + (uint64_t)(j->sy + ly - j->dy) * j->bpr);
+		const uint32_t *r1 = (ly + 1 < j->dy + j->h) ? (const uint32_t *)((const uint8_t *)r0 + j->bpr) : r0;
+		uint32_t *d = (uint32_t *)(fb->fPixels + (uint64_t)(fb->fFitY + py) * fb->fRowBytes +
+		    (uint64_t)(fb->fFitX + j->pxFrom) * 4);
+		int32_t shift = j->sx - j->dx, lastc = j->dx + j->w - 1;
+		if (filter) {
+			for (int32_t px = j->pxFrom; px < j->pxTo; px++) {
+				int32_t c = xt[px], i = c + shift, i1 = c < lastc ? i + 1 : i;
+				uint32_t a = SWEET_AVG(r0[i], r0[i1]);
+				uint32_t b = SWEET_AVG(r1[i], r1[i1]);
+				*d++ = SWEET_AVG(a, b);
+			}
+		} else {
+			for (int32_t px = j->pxFrom; px < j->pxTo; px++) {
+				*d++ = r0[xt[px] + shift];
+			}
+		}
+	}
+}
+
+static uint32_t sweet_scale_gen;
+static const SweetScale *sweet_scale_job;
+static int32_t sweet_scale_bands;
+static volatile SInt32 sweet_scale_left;
+
+static void
+sweet_scale_band_n(const SweetScale *j, int32_t band, int32_t bands)
+{
+	int32_t H = j->fb->fFitH;
+	sweet_scale_band(j, (int32_t)(((int64_t)H * band) / bands), (int32_t)(((int64_t)H * (band + 1)) / bands));
+}
+
+static void
+sweet_scale_worker(void *arg, __unused wait_result_t wr)
+{
+	int32_t band = (int32_t)(uintptr_t)arg;
+	uint32_t seen = 0;
+	for (;;) {
+		IOLockLock(sweet_scale_lock);
+		while (sweet_scale_gen == seen) {
+			IOLockSleep(sweet_scale_lock, &sweet_scale_gen, THREAD_UNINT);
+		}
+		seen = sweet_scale_gen;
+		const SweetScale *j = sweet_scale_job;
+		int32_t bands = sweet_scale_bands;
+		IOLockUnlock(sweet_scale_lock);
+		sweet_scale_band_n(j, band, bands);
+		OSDecrementAtomic(&sweet_scale_left);
+	}
+}
+
+/* Runs one layer over all bands and returns when every band is done. */
+static void
+sweet_scale_run(const SweetScale *j, int32_t bands)
+{
+	if (bands > 1) {
+		IOLockLock(sweet_scale_lock);
+		sweet_scale_job = j;
+		sweet_scale_bands = bands;
+		sweet_scale_left = bands - 1;
+		sweet_scale_gen++;
+		IOLockWakeup(sweet_scale_lock, &sweet_scale_gen, false);
+		IOLockUnlock(sweet_scale_lock);
+	}
+	sweet_scale_band_n(j, 0, bands);
+	if (bands > 1) {
+		while (sweet_scale_left > 0) {
+			__asm__ volatile ("yield");
+		}
+	}
+}
+
+void
+AppleCLCD::presentFired(OSObject *owner, __unused IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec != NULL) {
+		IOLockLock(fb->fLock);
+		memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+		fb->fDirty = false;
+		IOLockUnlock(fb->fLock);
+		uint64_t t0 = mach_absolute_time(), ns;
+		fb->present(rec);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+		fb->fStatNs += ns;
+		if (++fb->fStatN == 240) {
+			IOLog("SWEET FB: present avg %llu us over 240 frames, filter %u, %u bands\n",
+			    fb->fStatNs / 240000, fb->fFilter, fb->fScaleThreads);
+			fb->fStatN = 0;
+			fb->fStatNs = 0;
+		}
+	}
+	fb->fPresentBusy = false;
+}
