diff --git a/osfmk/arm/machine_routines_common.c b/osfmk/arm/machine_routines_common.c
index a6af1b9..4e9befa 100644
--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1283,6 +1283,22 @@ ml_set_max_cpus(unsigned int max_cpus __unused)
 unsigned int
 ml_wait_max_cpus(void)
 {
+#if defined(SWEET)
+	/*
+	 * SWEET boots and runs only the boot CPU, and no CPU driver calls
+	 * ml_set_max_cpus() on this platform.  Every caller of this function
+	 * (workq_open, dtrace, mcache, ...) only wants a cpu count for sizing,
+	 * so return it without waiting for a flag that nobody sets.  Without
+	 * this launchd blocks forever in workq_open (syscall 367).
+	 */
+	static int sweet_waited;
+	if (!sweet_waited) {
+		printf("SWML: ml_wait_max_cpus() short-circuits (max_cpus %u)\n",
+		    machine_info.max_cpus);
+		sweet_waited = 1;
+	}
+	return machine_info.max_cpus;
+#else
 	assert(lockdown_done);
 	lck_mtx_lock(&max_cpus_lock);
 	while (max_cpus_initialized != MAX_CPUS_SET) {
@@ -1291,6 +1307,7 @@ ml_wait_max_cpus(void)
 	}
 	lck_mtx_unlock(&max_cpus_lock);
 	return machine_info.max_cpus;
+#endif /* SWEET */
 }
 
 void
