diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -911,8 +911,53 @@
 IOService *
 IOService::getServiceRoot( void )
 {
 	return gIOServiceRoot;
 }
 
+#if defined(SWEET)
+/*
+ * Registry diagnosis and late IOResources registration.  setPlatform() runs
+ * before the platform expert is reachable from the registry root, so every
+ * attach/register attempt there fails ("not registry member").  This runs
+ * from bsd_init() after IOKitStart, when the tree is complete.
+ */
+extern "C" void
+sweet_iokit_rootinfo(uint64_t *out)
+{
+	out[0] = (uint64_t)(uintptr_t)getRegistryRoot();
+	out[1] = (uint64_t)(uintptr_t)gIOServiceRoot;
+	out[2] = (uint64_t)(uintptr_t)gIOResources;
+	out[3] = gIOResources ? (uint64_t)(uintptr_t)gIOResources->getParentEntry(gIOServicePlane) : 0;
+	out[4] = (uint64_t)(uintptr_t)gIOPlatform;
+}
+
+extern "C" void
+sweet_iokit_late_init(void)
+{
+	IORegistryEntry *root;
+
+	IOLog("SWEET IOK: late root=%p svcroot=%p res=%p resp=%p plat=%p\n",
+	    getRegistryRoot(), gIOServiceRoot, gIOResources,
+	    gIOResources ? gIOResources->getParentEntry(gIOServicePlane) : NULL,
+	    gIOPlatform);
+	if (gIOResources == NULL || gIOUserResources == NULL) {
+		return;
+	}
+	root = gIOServiceRoot ? gIOServiceRoot :
+	    (gIOPlatform ? (IORegistryEntry *)gIOPlatform : getRegistryRoot());
+	if (gIOResources->getParentEntry(gIOServicePlane) == NULL) {
+		IOLog("SWEET IOK: late attach IOResources=%d\n",
+		    gIOResources->attachToParent(root, gIOServicePlane));
+	}
+	if (gIOUserResources->getParentEntry(gIOServicePlane) == NULL) {
+		gIOUserResources->attachToParent(root, gIOServicePlane);
+	}
+	gIOResources->registerService();
+	gIOUserResources->registerService();
+	IOLog("SWEET IOK: late registered res=%p resp=%p\n", gIOResources,
+	    gIOResources->getParentEntry(gIOServicePlane));
+}
+#endif
+
 void
 IOService::detach( IOService * provider )
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -800,4 +800,10 @@
 	bsd_init_kprintf("calling bsd_autoconf\n");
 	bsd_autoconf();
+#if defined(SWEET)
+	{
+		extern void sweet_iokit_late_init(void);
+		sweet_iokit_late_init();
+	}
+#endif
 
 #if CONFIG_DTRACE
