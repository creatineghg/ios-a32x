diff --git a/osfmk/arm64/genassym.c b/osfmk/arm64/genassym.c
index 19eb823..905246d 100644
--- a/osfmk/arm64/genassym.c
+++ b/osfmk/arm64/genassym.c
@@ -295,6 +295,7 @@ main(int     argc,
 	DECLARE("PAGE_MAX_SIZE", PAGE_MAX_SIZE);
 
 	DECLARE("BA_VIRT_BASE", offsetof(struct boot_args, virtBase));
+	DECLARE("BA_VIDEO", offsetof(struct boot_args, Video));
 	DECLARE("BA_PHYS_BASE", offsetof(struct boot_args, physBase));
 	DECLARE("BA_MEM_SIZE", offsetof(struct boot_args, memSize));
 	DECLARE("BA_TOP_OF_KERNEL_DATA", offsetof(struct boot_args, topOfKernelData));
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..d6fef77 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,7 +515,9 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	ldr		x0, [x20, BA_VIDEO]
+	MOV64	x1, (2368 * 4320)
+	add		x0, x0, x1
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -686,7 +688,9 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	ldr		x10, [x20, BA_VIDEO]
+	lsr		x10, x10, #25
+	lsl		x10, x10, #25
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
