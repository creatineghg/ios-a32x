--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -381,6 +381,8 @@
 bool
 SweetHIDButtons::start(IOService *provider)
 {
+	IOLog("SWEET HID: buttons start provider=%p\n", provider);
 	if (!IOHIDEventService::start(provider)) {
+		IOLog("SWEET HID: buttons super::start failed\n");
 		return false;
 	}
@@ -428,7 +430,9 @@
 bool
 SweetHIDTouch::start(IOService *provider)
 {
+	IOLog("SWEET HID: touch start provider=%p\n", provider);
 	fLock = IOLockAlloc();
 	if (!fLock || !IOHIDEventService::start(provider)) {
+		IOLog("SWEET HID: touch init failed lock=%p\n", fLock);
 		return false;
 	}
