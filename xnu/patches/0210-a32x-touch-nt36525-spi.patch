+/*
+ * a32x touch: Novatek NT36525 (TDDI, boots from its own flash) on SPI1
+ * (MT6853 SPI @0x11010000, mt6765-compatible IP, polled FIFO mode, CS held
+ * across 32-byte packets with PAUSE). Clock gate ifrao_spi1 = infracfg_ao
+ * +0xA8 (CLR) bit 6, status +0xAC. NVT protocol (nt36xxx): set page =
+ * write {0xFF, addr>>15, addr>>7}; read = {addr & 0x7F, dummy, data...};
+ * event buffer 0x11A00, 6 bytes per finger (id<<3 | status, x/y 12 bit).
+ * Coordinates are A32 panel pixels (720x1600) and are mapped through the
+ * framebuffer fit (0208) into the space SweetHIDTouch expects (0058/0061:
+ * the centred 1080x2400 part of 1125x2436).
+ * Boot-args: a32xtouch=0 off, a32xtouchhz (default 60), a32xspidiv (sck
+ * half-period ticks, default 8).
+ */
+#define A32X_SPI1_PA        0x11010000u
+#define A32X_INFRA_AO_PA    0x10001000u
+#define A32X_NVT_EVENT_BUF  0x11A00u
+
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+static vm_offset_t a32x_spi;
+static uint32_t a32x_spi_base_cmd;
+static uint32_t a32x_spi_errors;
+
+#define SPIR(o)     (*(volatile uint32_t *)(a32x_spi + (o)))
+
+static bool
+a32x_spi_wait(void)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(5 * NSEC_PER_MSEC, &deadline);
+	deadline += mach_absolute_time();
+	while (SPIR(0x1c) == 0) {               /* STATUS0: finish/pause, read-clear */
+		if (mach_absolute_time() > deadline) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+a32x_spi_init(uint32_t sck)
+{
+	/* CMD: mode 0, MSB first, little endian FIFO words, no DMA, no deassert */
+	a32x_spi_base_cmd = (1u << 12) | (1u << 13);
+	SPIR(0x18) = a32x_spi_base_cmd | (1u << 2);     /* reset */
+	SPIR(0x18) = a32x_spi_base_cmd;
+	SPIR(0x24) = 0;                                 /* PAD_SEL */
+	SPIR(0x00) = (0x10u << 16) | 0x10u;             /* CFG0 (enhanced): cs setup / hold */
+	SPIR(0x04) = (SPIR(0x04) & ~(0xffu | 0xe0000000u)) | 0x10u;  /* CFG1: cs idle, tick dly 0 */
+	SPIR(0x28) = ((sck - 1) << 16) | (sck - 1);     /* CFG2: sck low / high */
+}
+
+/* Full-duplex transfer of len bytes (len <= 256), CS held for the whole buffer. */
+static int
+a32x_spi_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	uint32_t off = 0;
+	bool first = true;
+	int rc = 0;
+
+	SPIR(0x18) = a32x_spi_base_cmd | (1u << 4);     /* PAUSE_EN: keep CS between packets */
+	while (off < len) {
+		uint32_t n = MIN(32u, len - off);
+		uint32_t c1 = SPIR(0x04);
+		c1 &= ~(0x3ff0000u | 0xff00u);
+		c1 |= (n - 1) << 16;                        /* packet length, loop 1 */
+		SPIR(0x04) = c1;
+		for (uint32_t i = 0; i < n; i += 4) {
+			uint32_t w = 0;
+			for (uint32_t b = 0; b < 4 && i + b < n; b++) {
+				w |= (uint32_t)tx[off + i + b] << (8 * b);
+			}
+			SPIR(0x10) = w;
+		}
+		uint32_t cmd = SPIR(0x18);
+		SPIR(0x18) = cmd | (first ? 1u : 2u);       /* ACT / RESUME */
+		first = false;
+		if (!a32x_spi_wait()) {
+			rc = -1;
+			break;
+		}
+		for (uint32_t i = 0; i < n; i += 4) {
+			uint32_t w = SPIR(0x14);
+			for (uint32_t b = 0; b < 4 && i + b < n; b++) {
+				rx[off + i + b] = (uint8_t)(w >> (8 * b));
+			}
+		}
+		off += n;
+	}
+	SPIR(0x18) = a32x_spi_base_cmd;                 /* drop PAUSE_EN */
+	SPIR(0x18) = a32x_spi_base_cmd | (1u << 2);     /* reset: deasserts CS, idle state */
+	SPIR(0x18) = a32x_spi_base_cmd;
+	return rc;
+}
+
+static int
+a32x_nvt_set_page(uint32_t addr)
+{
+	uint8_t tx[3] = { 0xFF, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) }, rx[3];
+	return a32x_spi_xfer(tx, rx, 3);
+}
+
+/* Read len bytes at addr (page already set) into out. */
+static int
+a32x_nvt_read(uint32_t addr, uint8_t *out, uint32_t len)
+{
+	uint8_t tx[80] = { 0 }, rx[80];
+	if (len + 2 > sizeof(tx)) {
+		return -2;
+	}
+	tx[0] = (uint8_t)(addr & 0x7F);
+	if (a32x_spi_xfer(tx, rx, len + 2) != 0) {
+		return -1;
+	}
+	memcpy(out, rx + 2, len);
+	return 0;
+}
+
+static void
+a32x_touch_map(int px, int py, int *ox, int *oy)
+{
+	/* 720x1600 panel -> 1125x2436 logical (fit: x * 1125/720, y offset 20 rows) -> 1080x2400 centred */
+	int lx = (int)(((int64_t)px * 1125) / 720);
+	int ly = (int)(((int64_t)(py - 20) * 1125) / 720);
+	*ox = lx - 22;
+	*oy = ly - 18;
+}
+
+static void
+a32x_touch_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t hz = 60, sck = 8;
+	uint8_t ev[66];
+	bool down[10] = { false };
+	uint32_t raw_logged = 0;
+	PE_parse_boot_argn("a32xtouchhz", &hz, sizeof(hz));
+	PE_parse_boot_argn("a32xspidiv", &sck, sizeof(sck));
+	if (hz == 0 || hz > 200) {
+		hz = 60;
+	}
+	if (sck == 0 || sck > 0xffff) {
+		sck = 8;
+	}
+
+	a32x_wdt_sleep((event_t)&a32x_spi, 5);
+	vm_offset_t infra = ml_io_map(A32X_INFRA_AO_PA, PAGE_SIZE);
+	uint32_t cg_before = *(volatile uint32_t *)(infra + 0xAC);
+	*(volatile uint32_t *)(infra + 0xA8) = 1u << 6;         /* ungate ifrao_spi1 */
+	uint32_t cg_after = *(volatile uint32_t *)(infra + 0xAC);
+	a32x_spi = ml_io_map(A32X_SPI1_PA, PAGE_SIZE);
+	printf("A32X TOUCH: infra CG2 sta %08x -> %08x; SPI1 cmd %08x cfg0 %08x cfg1 %08x cfg2 %08x pad %08x\n",
+	    cg_before, cg_after, SPIR(0x18), SPIR(0x00), SPIR(0x04), SPIR(0x28), SPIR(0x24));
+	a32x_spi_init(sck);
+
+	/* chip id (trim) at 0x1F64E and firmware info at EVENT_BUF | 0x78 */
+	uint8_t id[8] = { 0 }, fw[8] = { 0 };
+	int r1 = a32x_nvt_set_page(0x1F64E);
+	int r2 = a32x_nvt_read(0x1F64E, id, 7);
+	int r3 = a32x_nvt_set_page(A32X_NVT_EVENT_BUF);
+	int r4 = a32x_nvt_read(A32X_NVT_EVENT_BUF | 0x78, fw, 8);
+	printf("A32X TOUCH: trim id %02x %02x %02x %02x %02x %02x %02x (rc %d %d), fwinfo %02x %02x %02x %02x %02x %02x %02x %02x (rc %d %d)\n",
+	    id[0], id[1], id[2], id[3], id[4], id[5], id[6], r1, r2,
+	    fw[0], fw[1], fw[2], fw[3], fw[4], fw[5], fw[6], fw[7], r3, r4);
+
+	for (;;) {
+		if (a32x_nvt_set_page(A32X_NVT_EVENT_BUF) == 0 &&
+		    a32x_nvt_read(A32X_NVT_EVENT_BUF, ev, 65) == 0) {
+			bool seen[10] = { false };
+			if (raw_logged < 6 && (ev[0] | ev[1] | ev[2] | ev[3])) {
+				raw_logged++;
+				printf("A32X TOUCH: ev %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7], ev[8], ev[9], ev[10], ev[11]);
+			}
+			for (int i = 0; i < 10; i++) {
+				const uint8_t *p = ev + 6 * i;        /* ev[0] = point_data[1] */
+				int fid = p[0] >> 3, st = p[0] & 7;
+				if (fid == 0 || fid > 10 || (st != 1 && st != 2)) {
+					continue;
+				}
+				int x = (p[1] << 4) | (p[3] >> 4), y = (p[2] << 4) | (p[3] & 0x0F);
+				if (x > 720 || y > 1600) {
+					continue;
+				}
+				int ox, oy;
+				a32x_touch_map(x, y, &ox, &oy);
+				seen[fid - 1] = true;
+				if (!down[fid - 1]) {
+					printf("A32X TOUCH: finger %d down at %d,%d\n", fid, x, y);
+				}
+				down[fid - 1] = true;
+				sweet_hid_touch(fid - 1, 1, ox, oy);
+			}
+			for (int f = 0; f < 10; f++) {
+				if (down[f] && !seen[f]) {
+					down[f] = false;
+					sweet_hid_touch(f, 0, 0, 0);
+					printf("A32X TOUCH: finger %d up\n", f + 1);
+				}
+			}
+		} else if (a32x_spi_errors++ < 8) {
+			printf("A32X TOUCH: SPI transfer timed out (status0 %08x cmd %08x)\n", SPIR(0x1c), SPIR(0x18));
+		}
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(NSEC_PER_SEC / hz, &deadline);
+		deadline += mach_absolute_time();
+		assert_wait_deadline((event_t)&a32x_spi, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+a32x_touch_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+	PE_parse_boot_argn("a32xtouch", &on, sizeof(on));
+	if (!on) {
+		printf("A32X TOUCH: off (a32xtouch=0)\n");
+		return;
+	}
+	if (kernel_thread_start(a32x_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A32X TOUCH: thread failed\n");
+	}
+}
+
 void a32x_wdt_kick_start(void);
 
