diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -185,14 +185,34 @@
+extern "C" int sweet_disp_stage = 0;
+
 IOService *
 sweet_display_create(IOService *provider)
 {
-	AppleCLCD *fb = new AppleCLCD;
+	AppleCLCD *fb;
 
+	sweet_disp_stage = 1;
+	fb = new AppleCLCD;
 	if (fb == NULL) {
+		sweet_disp_stage = -1;
 		return NULL;
 	}
-	if (!fb->init() || !fb->attach(provider) || !fb->start(provider)) {
+	sweet_disp_stage = 2;
+	if (!fb->init()) {
+		sweet_disp_stage = -2;
+		fb->release();
+		return NULL;
+	}
+	sweet_disp_stage = 3;
+	if (!fb->attach(provider)) {
+		sweet_disp_stage = -3;
+		fb->release();
+		return NULL;
+	}
+	sweet_disp_stage = 4;
+	if (!fb->start(provider)) {
+		sweet_disp_stage = -4;
 		fb->release();
 		return NULL;
 	}
+	sweet_disp_stage = 5;
 	return fb;
 }
