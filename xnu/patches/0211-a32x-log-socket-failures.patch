+/* a32x: log failed socket() calls (first 64), to find daemons blocked on missing protocols */
+static int a32x_sock_logged;
+static int
+a32x_sock_fail(proc_ref_t p, int domain, int type, int protocol, int error, const char *where)
+{
+	if (a32x_sock_logged < 64) {
+		a32x_sock_logged++;
+		printf("A32X SOCK: %s[%d] socket(%d, %d, %d) failed in %s: %d\n",
+		    proc_best_name(p), proc_pid(p), domain, type, protocol, where, error);
+	}
+	return error;
+}
