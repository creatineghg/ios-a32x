diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -59,6 +59,63 @@
 	}
 	return PROC_RETURNED;
 }
 
+/*
+ * SWEET process-table probe: one compact line on the manual console, so that
+ * "launchd reached N daemons" is visible on the screen and daemon churn can be
+ * followed.  Names are snapshotted under proc_list_lock and printed after it
+ * is dropped: kprintf() can block on the console and must not run while the
+ * process list is held.
+ */
+#define SWEET_PROCS_SHOWN 12
+
+struct sweet_proc_snap {
+	int pid;
+	char comm[MAXCOMLEN + 1];
+};
+
+void
+sweet_procs_print(void)
+{
+	struct sweet_proc_snap snap[SWEET_PROCS_SHOWN];
+	int shown = 0, total = 0;
+	proc_t p;
+
+	proc_list_lock();
+	ALLPROC_FOREACH(p) {
+		if (p->p_stat == SIDL) {
+			continue;       /* still forking: no name yet */
+		}
+		total++;
+		if (shown < SWEET_PROCS_SHOWN) {
+			snap[shown].pid = proc_pid(p);
+			strlcpy(snap[shown].comm, p->p_comm,
+			    sizeof(snap[shown].comm));
+			shown++;
+		}
+	}
+	proc_list_unlock();
+
+	printf("SWEET: procs=%d [", total);
+	for (int i = 0; i < shown; i++) {
+		printf("%s%d:%s", i != 0 ? " " : "", snap[i].pid, snap[i].comm);
+	}
+	if (total > shown) {
+		printf(" +%d", total - shown);
+	}
+	printf("]\n");
+}
+
+static void
+sweet_procs_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	(void)tsleep(&chan, PZERO, "sweetprc", 30 * hz);
+	for (;;) {
+		sweet_procs_print();
+		(void)tsleep(&chan, PZERO, "sweetprc", 60 * hz);
+	}
+}
+
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
@@ -81,8 +138,12 @@
 void
 sweet_sample_start(void)
 {
 	thread_t thread;
+
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	if (kernel_thread_start(sweet_procs_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
