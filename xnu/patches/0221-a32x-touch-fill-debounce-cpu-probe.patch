+/*
+ * a32x: real clock of each core (PMU cycle counter against the system timer,
+ * 1 ms, interrupts off). Boot firmware picks the clocks; XNU has no DVFS here.
+ */
+extern processor_t cpu_to_processor(int cpu);
+extern processor_t thread_bind(processor_t processor);
+
+static void
+a32x_cpu_probe(__unused void *arg, __unused wait_result_t wr)
+{
+	a32x_sleep_ms(15000);
+	for (int i = 0; i < 8; i++) {
+		processor_t p = cpu_to_processor(i);
+		uint64_t t0, t1, c0, c1, mpidr, ns, v;
+		if (p == NULL) {
+			continue;
+		}
+		thread_bind(p);
+		thread_block(THREAD_CONTINUE_NULL);
+		boolean_t intr = ml_set_interrupts_enabled(FALSE);
+		__asm__ volatile ("mrs %0, MPIDR_EL1" : "=r"(mpidr));
+		__asm__ volatile ("mrs %0, PMCR_EL0" : "=r"(v));
+		v |= 1;
+		__asm__ volatile ("msr PMCR_EL0, %0" : : "r"(v));
+		v = 1ull << 31;
+		__asm__ volatile ("msr PMCNTENSET_EL0, %0" : : "r"(v));
+		__asm__ volatile ("isb sy");
+		t0 = mach_absolute_time();
+		__asm__ volatile ("mrs %0, PMCCNTR_EL0" : "=r"(c0));
+		a32x_spin_us(1000);
+		__asm__ volatile ("mrs %0, PMCCNTR_EL0" : "=r"(c1));
+		t1 = mach_absolute_time();
+		ml_set_interrupts_enabled(intr);
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+		printf("A32X CPU: logical %d mpidr 0x%llx: %llu MHz\n", i, mpidr & 0xffffff, ns ? ((c1 - c0) * 1000) / ns : 0);
+	}
+	thread_bind((processor_t)NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	for (;;) {
+		a32x_sleep_ms(3600000);
+	}
+}
