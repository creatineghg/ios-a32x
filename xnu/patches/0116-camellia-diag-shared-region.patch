diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe..7e673c5 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -49,6 +49,31 @@ extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 extern int hz;
 static void sweet_log_start(void);
+
+#if defined(SWEET)
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(10ull * NSEC_PER_SEC, &deadline);
+		deadline += mach_absolute_time();
+		assert_wait_deadline_with_leeway((event_t)&sweet_hb_thread, THREAD_UNINT,
+		    TIMEOUT_URGENCY_SYS_CRITICAL, deadline, 0);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("SWEET: hb\n");
+	}
+}
+
+static void
+sweet_hb_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sweet_hb_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif
 extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_touch_init(void);
@@ -655,6 +680,9 @@ sweet_ufs_init(void)
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
 	sweet_log_start();
+#if defined(SWEET)
+	sweet_hb_start();
+#endif
 	sweet_sample_start();
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
 	sweet_keys_init();
