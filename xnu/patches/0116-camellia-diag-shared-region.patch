diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 7fd9be1..dec73c4 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -102,6 +102,24 @@ unix_syscall(
 
 	code = arm_get_syscall_number(state);
 
+#if defined(SWEET)
+	/*
+	 * SWEET bring-up: entry+return trace for pid 1.  A "syscall N" line
+	 * without a matching "ret N" names the call that never returns.
+	 */
+	{
+		static int sweet_pid1_calls;
+		if (proc_pid(proc) == 1) {
+			if (sweet_pid1_calls < 1000) {
+				printf("SWEETPID1 syscall %u\n", (unsigned)code);
+			} else if (sweet_pid1_calls == 1000) {
+				printf("SWEETPID1 trace cap reached\n");
+			}
+			sweet_pid1_calls++;
+		}
+	}
+#endif
+
 #define unix_syscall_kprintf(x...)      /* kprintf("unix_syscall: " x) */
 
 	if (kdebug_enable && !code_is_kdebug_trace(code)) {
@@ -177,8 +195,37 @@ unix_syscall(
 	}
 #endif /* CONFIG_DEBUG_SYSCALL_REJECTION */
 
+#if defined(SWEET)
+	/*
+	 * SWEET bring-up: pid 1 hangs inside sysctl(2); print which mib, and
+	 * which path it was opening, so the last line before the hang is a name.
+	 */
+	if (proc_pid(proc) == 1 && code == 202 /* sysctl */) {
+		int sweet_mib[2] = { -1, -1 };
+		if (copyin((user_addr_t)uthread->uu_arg[0], sweet_mib, sizeof(sweet_mib)) == 0) {
+			printf("SWEETPID1 sysctl %d.%d\n", sweet_mib[0], sweet_mib[1]);
+		}
+	}
+	if (proc_pid(proc) == 1 && code == SYS_open) {
+		char sweet_path[128];
+		if (copyinstr((user_addr_t)uthread->uu_arg[0], sweet_path, sizeof(sweet_path), NULL) == 0) {
+			printf("SWEETPID1 open %s\n", sweet_path);
+		}
+	}
+#endif
+
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
+
+#if defined(SWEET)
+	{
+		static int sweet_pid1_rets;
+		if (proc_pid(proc) == 1 && sweet_pid1_rets < 1000) {
+			printf("SWEETPID1 ret %u %d\n", (unsigned)code, error);
+			sweet_pid1_rets++;
+		}
+	}
+#endif
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 
