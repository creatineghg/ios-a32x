diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe..feeffda 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -49,6 +49,37 @@ extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 extern int hz;
 static void sweet_log_start(void);
+
+#if defined(SWEET)
+unsigned sweet_io_total;
+extern unsigned sweet_syscall_count;
+extern int sweet_last_syscall;
+extern unsigned sweet_fault_count;
+
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(10ull * NSEC_PER_SEC, &deadline);
+		deadline += mach_absolute_time();
+		assert_wait_deadline_with_leeway((event_t)&sweet_hb_thread, THREAD_UNINT,
+		    TIMEOUT_URGENCY_SYS_CRITICAL, deadline, 0);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("SWEET: hb syscalls=%u last=%d faults=%u io=%u\n",
+		    sweet_syscall_count, sweet_last_syscall, sweet_fault_count, sweet_io_total);
+	}
+}
+
+static void
+sweet_hb_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sweet_hb_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif
 extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_touch_init(void);
