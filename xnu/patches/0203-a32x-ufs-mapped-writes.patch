+/*
+ * a32x: partition-relative writes go through the extent map like reads, so
+ * only blocks of the pinned iosroot file can ever be written; anything the
+ * map does not cover is refused (the rest of userdata is Android's f2fs).
+ */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (a32x_ext_state == 0) {
+		a32x_ext_load();
+	}
+	if (a32x_ext_state < 0 || su.first_block == 0 || lba < su.first_block) {
+		return ufs_write_blocks_dev(lba, count);
+	}
+	uint64_t rel = lba - su.first_block, abs;
+	uint64_t run = a32x_ext_map(rel, &abs);
+	if (run >= count) {
+		return ufs_write_blocks_dev(abs, count);
+	}
+	/* crosses runs or unmapped: scatter the bounce piecewise */
+	uint8_t *bounce = (uint8_t *)(su.dma + DMA_BOUNCE);
+	memcpy(a32x_ext_tmp, bounce, (size_t)count * UFS_BLOCK);
+	for (uint32_t done = 0; done < count;) {
+		run = a32x_ext_map(rel + done, &abs);
+		if (run == 0) {
+			printf("A32X UFS: refusing write to unmapped block %llu\n", rel + done);
+			return EPERM;
+		}
+		uint32_t n = (uint32_t)MIN(run, (uint64_t)(count - done));
+		memcpy(bounce, a32x_ext_tmp + (size_t)done * UFS_BLOCK, (size_t)n * UFS_BLOCK);
+		int error = ufs_write_blocks_dev(abs, n);
+		if (error) {
+			return error;
+		}
+		done += n;
+	}
+	return 0;
+}
