+/*
+ * a32x (0223): frames were drawn straight into the buffer the panel scans out,
+ * which tears. Now two buffers: draw into the hidden one and point the OVL layer
+ * at it (MT6853 DISP_OVL0/OVL0_2L, L0-L3 address 0xf40 + 0x20n, shadow bypassed).
+ * Set up only if a layer really scans our framebuffer (M4U off, phys address);
+ * otherwise it stays single-buffered. sweetfb_flip=0 disables it.
+ */
+static const uint32_t sweet_ovl_pa[2] = { 0x14005000u, 0x14006000u };
+static volatile uint32_t *sweet_flip_addr;
+static uint64_t sweet_flip_phys[2];
+static uintptr_t sweet_flip_va[2];
+static int sweet_flip_front;            /* index the panel scans */
+static uint64_t sweet_flip_last;        /* time of the last flip */
+static uintptr_t sweet_flip_draw;       /* draw target of this frame, 0 = fPixels */
+
+static void
+sweet_flip_setup(AppleCLCD *fb)
+{
+	static bool done;
+	int on = 1;
+	if (done) {
+		return;
+	}
+	done = true;
+	PE_parse_boot_argn("sweetfb_flip", &on, sizeof(on));
+	if (!on) {
+		IOLog("SWEET FB: flip off (sweetfb_flip=0)\n");
+		return;
+	}
+	volatile uint32_t *found = NULL, *base = NULL;
+	for (int o = 0; o < 2 && found == NULL; o++) {
+		volatile uint8_t *ovl = (volatile uint8_t *)ml_io_map(sweet_ovl_pa[o], 0x1000);
+		uint32_t src = *(volatile uint32_t *)(ovl + 0x2c);
+		for (int n = 0; n < 4; n++) {
+			uint32_t a = *(volatile uint32_t *)(ovl + 0xf40 + 0x20 * n);
+			IOLog("SWEET FB: ovl %x L%d addr %08x src_con %08x en %08x\n", sweet_ovl_pa[o], n, a, src,
+			    *(volatile uint32_t *)(ovl + 0x0c));
+			if (found == NULL && a == (uint32_t)fb->fPhys) {
+				found = (volatile uint32_t *)(ovl + 0xf40 + 0x20 * n);
+				base = (volatile uint32_t *)ovl;
+			}
+		}
+	}
+	if (found == NULL) {
+		IOLog("SWEET FB: no overlay layer scans 0x%llx, single buffer\n", fb->fPhys);
+		return;
+	}
+	IOByteCount size = (IOByteCount)fb->fRowBytes * fb->fHeight;
+	/* write-combined at creation: a second mapping with another cache mode is refused */
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMapWriteCombineCache, size, 0x00000000FFFFF000ULL);
+	if (mem == NULL) {
+		IOLog("SWEET FB: no contiguous %llu byte buffer below 4 GB, single buffer\n", (uint64_t)size);
+		return;
+	}
+	if (mem->getBytesNoCopy() == NULL) {
+		IOLog("SWEET FB: second buffer has no kernel mapping, single buffer\n");
+		return;
+	}
+	sweet_flip_phys[0] = fb->fPhys;
+	sweet_flip_va[0] = fb->fPixels;
+	sweet_flip_phys[1] = mem->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+	sweet_flip_va[1] = (uintptr_t)mem->getBytesNoCopy();
+	bzero((void *)sweet_flip_va[1], size);
+	*(volatile uint32_t *)((uintptr_t)base + 0x0c) |= (1u << 22);   /* DISP_OVL_BYPASS_SHADOW */
+	sweet_flip_addr = found;
+	sweet_flip_front = 0;
+	IOLog("SWEET FB: flip on, second buffer at 0x%llx\n", sweet_flip_phys[1]);
+}
