diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -85,4 +85,34 @@
 /* 0 = not started, 1 = running, <0 = failed stage (see AppleCLCD::start). */
 extern "C" int sweet_display_state = 0;
 
+/*
+ * Diagnostic: number of services of a class currently in the registry, so
+ * the heartbeat can show whether IOResources/IOWatchdog/IOMobileFramebuffer
+ * actually matched.
+ */
+extern "C" int
+sweet_iokit_count(const char *cls)
+{
+	OSDictionary *match;
+	OSIterator *it;
+	int n = 0;
+
+	if (IOService::getServiceRoot() == NULL) {
+		return -2;      /* IOKit not up yet */
+	}
+	match = IOService::serviceMatching(cls);
+	if (match == NULL) {
+		return -1;
+	}
+	it = IOService::getMatchingServices(match);
+	if (it != NULL) {
+		while (it->getNextObject() != NULL) {
+			n++;
+		}
+		it->release();
+	}
+	match->release();
+	return n;
+}
+
 class IOMobileFramebuffer : public IOService {
