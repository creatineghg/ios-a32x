index 02ad086..d29aa00 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1234,6 +1234,29 @@ a32x_wdt_thread(__unused void *arg, __unused wait_result_t wr)
 #define A32X_MT6359_TOPSTATUS 0x2au
 
 extern void sweet_hid_key(int key, int down);  /* iokit/Kernel/arm/hid/SweetHID.cpp */
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+/*
+ * a32xvoldown_swipe=1 (default): Volume Down plays a swipe up from the bottom
+ * edge (unlock / Home gesture on the Face-ID class UI) on finger slot 9, in
+ * SweetHIDTouch coordinates (centred 1080x2400 part of 1125x2436; the edge flag
+ * of patch 0071 applies within 48 px of the bottom).
+ */
+static void
+a32x_fake_swipe_up(void)
+{
+	for (int i = 0; i <= 12; i++) {
+		int y = 2395 - i * 100;
+		sweet_hid_touch(9, 1, 540, y);
+		uint64_t dl;
+		nanoseconds_to_absolutetime(16 * NSEC_PER_MSEC, &dl);
+		dl += mach_absolute_time();
+		assert_wait_deadline((event_t)&a32x_fake_swipe_up, THREAD_UNINT, dl);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	sweet_hid_touch(9, 0, 540, 1195);
+	printf("A32X KEYS: fake swipe up sent\n");
+}
 
 static vm_offset_t a32x_kp, a32x_pwrap;
 static uint32_t a32x_pwrap_errors;
@@ -1280,9 +1303,10 @@ static void
 a32x_keys_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	static const char *names[] = { "power", "volume up", "volume down" };
-	uint32_t voldown_home = 0;
+	uint32_t voldown_home = 0, voldown_swipe = 1;
 	bool last[3] = { false, false, false };
 	PE_parse_boot_argn("a32xvoldown_home", &voldown_home, sizeof(voldown_home));
+	PE_parse_boot_argn("a32xvoldown_swipe", &voldown_swipe, sizeof(voldown_swipe));
 
 	uint32_t top = 0xffff;
 	int rc = a32x_pwrap_read(A32X_MT6359_TOPSTATUS, &top);
@@ -1310,8 +1334,14 @@ a32x_keys_thread(__unused void *arg, __unused wait_result_t wr)
 			if (now[k] != last[k]) {
 				int hid = (k == 2 && voldown_home) ? 3 : k;
 				printf("A32X KEYS: %s %s\n", names[k], now[k] ? "down" : "up");
-				sweet_hid_key(hid, now[k]);
 				last[k] = now[k];
+				if (k == 2 && voldown_swipe && !voldown_home) {
+					if (now[k]) {
+						a32x_fake_swipe_up();
+					}
+					continue;
+				}
+				sweet_hid_key(hid, now[k]);
 			}
 		}
 		uint64_t deadline;
