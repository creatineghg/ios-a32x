+/* partition-relative block -> absolute lba; returns blocks left in that run (0: unmapped) */
+static uint64_t
+a32x_ext_map(uint64_t rel, uint64_t *abs)
+{
+	for (uint32_t i = 0; i < a32x_ext_runs; i++) {
+		uint64_t lo = a32x_ext[3 * i], n = a32x_ext[3 * i + 2];
+		if (rel >= lo && rel < lo + n) {
+			*abs = su.first_block + a32x_ext[3 * i + 1] + (rel - lo);
+			return lo + n - rel;
+		}
+	}
+	return 0;
+}
